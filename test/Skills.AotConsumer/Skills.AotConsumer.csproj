<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Not a shipping artifact: this is the consumer-side AOT proof. It references
         Skills.csproj the way an embedding host (Nitro) would, composes SkillsCommand into its
         own root command per docs/embedding.md, and publishes AOT so CI can assert the library
         is AOT-compatible as a package contract, not just as the standalone skills binary. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>aotconsumer</AssemblyName>
    <RootNamespace>Skills.AotConsumer</RootNamespace>
    <PublishAot>true</PublishAot>
    <RuntimeIdentifiers>linux-x64;osx-arm64;win-x64</RuntimeIdentifiers>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Skills/Skills.csproj" />
  </ItemGroup>
</Project>
